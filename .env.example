# Modelo de configuração local — copie este arquivo para .env:
#   cp .env.example .env
#
# Caminho do arquivo JSON de dados, relativo à raiz do projeto.
# O padrão abaixo usa os dados fictícios de exemplo; quando seus dados
# estiverem prontos, substitua data/portfolio.json e remova o .env
# (sem .env, o sistema usa data/portfolio.json — o mesmo que o GitHub Pages usa).
PORTFOLIO_JSON=data/portfolio.example.json
